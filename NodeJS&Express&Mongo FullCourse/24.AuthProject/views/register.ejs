<%- include('template',{title:'register'})  %>

<h1 class="text-center text-2xl font-bold">Register</h1>

<div class="m-auto shadow-2xl w-1/2 p-5">
    <form method="post" action="/register" class="flex flex-col justify-center items-center">

        <label for="name">Name</label>
        <input type="text" id="name" name="name">
        
        <label for="email">Email</label>
        <input type="email" id="email" name="email">
        
        <label for="password">Password</label>
        <input type="password" id="password" name="password">
        <button type="submit" class="bg-blue-500 rounded-full p-2 text-white">Submit form</button>
        
    </form>
</div>