<style>
    .font{
        font-family: "DynaPuff", system-ui;
        font-optical-sizing: auto;
        font-style: normal;
        font-variation-settings:
        "wdth" 100;
    }
    a:hover,button:hover{
        cursor: pointer;
    }
    label{
        font-size: large;
    }
    #play{
        animation: spin 10s infinite ;
